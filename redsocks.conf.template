base {
    log_debug = off;
    log_info = on;
    log = stderr;
    daemon = off;
    redirector = iptables;
}

redsocks {
    local_ip = 0.0.0.0;
    local_port = 12345;
    ip = __UPSTREAM_PROXY_HOST__;
    port = __UPSTREAM_PROXY_PORT__;
    type = http-connect;
    login = "__UPSTREAM_PROXY_USER__";
    password = "__UPSTREAM_PROXY_PASS__";
}
